# Backend API Base URL
# For local office Wi-Fi: leave blank (auto-resolves to http://<host-ip>:3000/api)
# For Vercel cloud deployment connecting to Render backend:
VITE_API_URL=https://<your-render-backend-name>.onrender.com/api
VITE_API_BASE_URL=https://<your-render-backend-name>.onrender.com/api

